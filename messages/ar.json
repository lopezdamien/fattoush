    "About": {
        "title": "قصتنا",
        "history": "تبدأ قصة فتوش في أزقة بيروت النابضة بالحياة، حيث تمتزج النكهات مع الضحكات والأحاديث المفعمة بالحيوية. عند وصولنا إلى جنيف في عام 1990، أردنا إعادة خلق هذا الجو الفريد: مائدة عامرة حيث يروي كل طبق قصة. لأكثر من 30 عامًا، حافظنا على الوصفات المتوارثة عن جداتنا، مضيفين لمستنا الحديثة مع احترام أصالة المنتجات.",
        "philosophy_title": "فلسفتنا",
        "philosophy": {
            "homemade": "صنع منزلي",
            "quality": "جودة عالية",
            "warmth": "استقبال دافئ",
            "sharing": "متعة المشاركة"
        }
    },
    "Traiteur": {
        "title": "خدمة التموين",
        "subtitle": "مطبخ فتوش لمناسباتكم الخاصة والمهنية في جنيف وسويسرا الرومندية.",
        "intro_title": "وجبة لبنانية سخية تصل إليكم",
        "intro_p1": "سواء كان الأمر يتعلق بحفل زفاف، أو عيد ميلاد، أو استقبال مؤسسي، أو عشاء مع الأصدقاء، نُعدّ المازة والمشاوي والأطباق المطهوة بنفس المنتجات الطازجة التي نستخدمها في مطعمنا في شارع ري دي غار.",
        "intro_p2": "كل طلب مُصمَّم خصيصاً لاحتياجاتكم — القائمة والكميات والتقديم — لجعل مناسبتكم ناجحة.",
